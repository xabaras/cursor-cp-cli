{
  "name": "cursor-cp-cli",
  "version": "0.5.3",
  "description": "Fork of cursor-cp with a Telegram bridge to existing Cursor CLI chats (agent -p --resume), plus the original web/Telegram SDK control plane",
  "type": "module",
  "license": "MIT",
  "author": "Sanjay Singh",
  "contributors": [
    "xabaras"
  ],
  "homepage": "https://github.com/xabaras/cursor-cp-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xabaras/cursor-cp-cli.git"
  },
  "bugs": {
    "url": "https://github.com/xabaras/cursor-cp-cli/issues"
  },
  "keywords": [
    "cursor",
    "cursor-sdk",
    "cursor-cli",
    "agent",
    "control-plane",
    "telegram-bot",
    "fastify",
    "typescript"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.16",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^11.3.0",
    "execa": "^9.3.1",
    "fastify": "^5.8.5",
    "js-yaml": "^4.1.0",
    "marked": "^18.0.4",
    "pino": "^9.14.0",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "eslint": "^9.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
